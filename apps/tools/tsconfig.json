{
  "extends": "@blastctrl/typescript-config/nextjs.json",
  "compilerOptions": {
    "checkJs": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.json"
  },
  "include": [".", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"],
  "exclude": ["node_modules", "public/gmeet-cc-capture.js", "scripts"]
}
