# Use a mainnet HTTPS RPC endpoint. Keep its API key on the server.
RPC_ENDPOINT=https://api.mainnet-beta.solana.com

# Required: use the effective fee rate from the website's deployment.
# Use 0 only when the website has no service fee.
RECLAIM_RENT_FEE_BPS=0

# Bind to loopback for local tests. Use 0.0.0.0 in a container. Vercel
# ignores HOST and PORT.
HOST=127.0.0.1
PORT=8787

# Required when a tunnel sends its public Host header. On Vercel the
# deployment's own domains are accepted without it.
# Use only the origin, without /mcp or a trailing slash.
# PUBLIC_ORIGIN=https://your-test-host.example
