{
  "name": "blastctrl-monorepo",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "format": "pnpm run --recursive format",
    "lint": "pnpm run --recursive lint",
    "build": "pnpm -F solace-sdk build && pnpm -F tools build",
    "api:update": "node packages/solace-sdk/scripts/update-api.mjs",
    "build:mcp": "pnpm --filter @blastctrl/mcp... build",
    "dev:mcp": "pnpm -F @blastctrl/rent-reclaimer build && pnpm -F @blastctrl/mcp dev",
    "test:mcp": "pnpm -F @blastctrl/rent-reclaimer build && pnpm -F @blastctrl/rent-reclaimer test && pnpm -F @blastctrl/mcp test"
  },
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@blastctrl/prettier-config": "workspace:^"
  },
  "packageManager": "pnpm@10.34.3+sha512.f2c531b08829d7be7f03c90addc266615f9c5477463e4bf1d275cb263ce9ea57cf0d5599110d94649a9bb3fed9f0b5efcea74a7016b61532a24cb9ad87860c1d"
}
